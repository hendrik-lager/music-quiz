# Spotify Developer App credentials
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Redirect URI must match exactly what you registered in the Spotify Developer Dashboard
# For local development:
SPOTIFY_REDIRECT_URI=http://localhost:8080/auth/spotify/callback
# For HomeLAB deployment (replace with your server's IP/hostname):
# SPOTIFY_REDIRECT_URI=http://192.168.1.100:8080/auth/spotify/callback

# Server config
PORT=8080
HOST=0.0.0.0

# Secret key for session security (generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=change_me_to_a_random_secret
