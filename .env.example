# Spotify Developer App-Zugangsdaten
# App erstellen unter: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# App-Hostname für Traefik-Routing (z.B. quiz.example.com)
APP_HOST=quiz.example.com

# Redirect-URI muss exakt mit der Spotify Developer Dashboard Einstellung übereinstimmen
SPOTIFY_REDIRECT_URI=https://quiz.example.com/api/auth/spotify/callback

# Admin-Token (beliebiges sicheres Passwort für den Admin-Bereich)
ADMIN_TOKEN=change_me_to_a_random_secret

# Server-Konfiguration
PORT=3000
HOST=0.0.0.0

# Datenpfade
DATA_DIR=./data
PLAYLISTS_DIR=./playlists
